# Copy to .env (never commit .env). Real environment variables take precedence over this file.

# Which LLM providers the ground-side copilot may use, in priority order:
#   auto (groq, then ollama) | groq | ollama | ollama,groq | off (rule-based templates only)
AEROMIND_LLM_PROVIDER=auto

# Groq (primary, cloud). Create a key at https://console.groq.com and paste it here.
GROQ_API_KEY=
# Optional: override the default model (see Groq's current model list)
GROQ_MODEL=

# Ollama (local fallback). `ollama pull llama3.2` first, then keep `ollama serve` running.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional shared secret for POST /api/ingest (edge agents send it as X-AeroMind-Token).
# Set it whenever the ground station listens on anything other than localhost.
AEROMIND_INGEST_TOKEN=
